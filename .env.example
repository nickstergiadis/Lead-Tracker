# Server-only Vercel environment variables. Never prefix these with VITE_ or expose them to the browser.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
SESSION_SECRET=generate-at-least-32-random-bytes
# Format: scrypt$<base64url salt>$<base64url 32-byte hash>. See README generation command.
AUTH_PASSWORD_HASH=scrypt$salt$hash
