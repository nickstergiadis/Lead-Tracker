# Server-only Vercel environment variables. Never prefix these with VITE_ or expose them to the browser.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
SESSION_SECRET=generate-at-least-32-random-bytes
RECOVERY_CODE_PEPPER=generate-a-different-32-byte-secret
INVITATION_PEPPER=generate-another-32-byte-secret
# Set both to the same temporary random value only while running bootstrap, then remove them.
BOOTSTRAP_TOKEN=
BOOTSTRAP_CONFIRM_TOKEN=
